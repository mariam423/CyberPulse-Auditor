{
  "name": "cyberpulse-auditor",
  "version": "0.1.0",
  "description": "Multi-Agent Security Copilot for OWASP LLM App Security",
  "type": "module",
  "bin": {
    "cyberpulse": "./dist/bin/cyberpulse.js"
  },
  "scripts": {

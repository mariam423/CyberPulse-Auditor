# ── CyberPulse Auditor — Unified Agent Provider Config ──────────────────────
#
# One API key, four agent environments (Copaw, OpenClaude, Hermes, Pi).
# Copy this file to `.env` (git-ignored) and fill in values.
# Keys are read from the environment ONLY — never committed, never logged.

# ── Shared credential (first defined wins) ───────────────────────────────────
# Canonical unified key used by ALL agents (Copaw, OpenClaude, Hermes, Pi):
UNIFIED_API_KEY=

# Fallback chain (checked only if UNIFIED_API_KEY is unset):
CYBERPULSE_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# ── Provider selection ───────────────────────────────────────────────────────
# anthropic | openai | openrouter
CYBERPULSE_PROVIDER=anthropic

# Model per provider (examples):
#   anthropic   → claude-sonnet-4-5
#   openai      → gpt-4o
#   openrouter  → anthropic/claude-sonnet-4.5
CYBERPULSE_MODEL=claude-sonnet-4-5

# ── Optional endpoint overrides ──────────────────────────────────────────────
# Custom base URLs (proxies, gateways, local relays):
CYBERPULSE_BASE_URL=
ANTHROPIC_BASE_URL=
OPENAI_BASE_URL=
OPENROUTER_BASE_URL=

# ── Behavioral parameters (security-audit tuned) ─────────────────────────────
# Token ceiling for agent completions.
CYBERPULSE_MAX_TOKENS=8192
# Low temperature = deterministic classification + patch generation.
CYBERPULSE_TEMPERATURE=0.2

# ═══════════════════════════════════════════════════════════════════════════
# CyberPulse Auditor — Environment template
# ═══════════════════════════════════════════════════════════════════════════
# Copy to `.env` and fill in values:     cp .env.example .env
# NEVER commit the real .env — it is git-ignored.

# ── Server ───────────────────────────────────────────────────────────────────
# Host port the GUI listens on (mapped into the container).
CYBERPULSE_PORT=3000

# Shared SQLite database path (inside the container; leave default for compose).
CYBERPULSE_DB_PATH=/app/data/cyberpulse.db

# ── Model providers (audit engine) ─────────────────────────────────────────
# Required for live audits. At least one provider key must be set.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional: local/remote Ollama or OpenAI-compatible gateway.
# MODEL_PROVIDER=openai
# MODEL_NAME=gpt-4o
# MODEL_BASE_URL=

# ── Agent mesh (Copaw / OpenClaude / Hermes / Pi) ───────────────────────────
# One unified key for all four agents — resolution order:
#   UNIFIED_API_KEY → CYBERPULSE_API_KEY → ANTHROPIC_API_KEY → OPENAI_API_KEY
UNIFIED_API_KEY=

# ── SaaS guardrails ──────────────────────────────────────────────────────────
# API rate limiting (requests per window).
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_MS=60000

# ── Scale-out (fleet / millions of users) ───────────────────────────────────
# Leave everything below UNSET for the default single-container mode
# (SQLite storage + in-process job queue + memory rate limiter).
#
# Postgres storage — set to activate the PostgresDriver (npm i pg):
# DATABASE_URL=postgres://user:pass@host:5432/cyberpulse
# Optional read replica for list/findings queries (CQRS-lite):
# DATABASE_READ_URL=postgres://user:pass@replica:5432/cyberpulse
# PG_POOL_MAX=10
#
# Shared rate limiting across N replicas (npm i ioredis):
# REDIS_URL=redis://host:6379
#
# Async job queue saturation threshold (load shedding → 503):
QUEUE_MAX_DEPTH=200

# ── Installer widget (download page) ────────────────────────────────────────
# Host serving the per-OS install scripts referenced by the /download page.
# NEXT_PUBLIC_INSTALL_SCRIPT_URL=https://cyberpulse.dev/install
# npm package name shown in the installer widget.
# NEXT_PUBLIC_NPM_PACKAGE=cyberpulse-auditor
